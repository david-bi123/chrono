# ChronoSwift — env template. Copy to .env.local for local dev. NEVER commit real secrets.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
AUTH_SECRET=generate-a-long-random-string-min-32-chars

# App URL (server-side; used in QR links + email links). No trailing slash.
APP_URL=http://localhost:3000

# Mailjet (transactional email)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_EMAIL=no-reply@chronoswift.example.com
MAIL_FROM_NAME=ChronoSwift

# Seed super admin (dev only)
SEED_SUPERADMIN_EMAIL=superadmin@chrono.local
SEED_SUPERADMIN_PASSWORD=ChangeMe123!
