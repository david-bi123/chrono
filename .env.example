# Chrono — env template. Copy to .env.local for local dev. NEVER commit real secrets.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
AUTH_SECRET=generate-a-long-random-string-min-32-chars

# Public app URL (used in QR links + email links). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mailjet (transactional email)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_EMAIL=no-reply@chrono.example.com
MAIL_FROM_NAME=Chrono

# Optional: Cloudinary (only if avatar uploads enabled via URL — default uses no upload)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Seed super admin (dev only)
SEED_SUPERADMIN_EMAIL=superadmin@chrono.local
SEED_SUPERADMIN_PASSWORD=ChangeMe123!
